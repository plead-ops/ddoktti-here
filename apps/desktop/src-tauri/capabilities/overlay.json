{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "HTML 알림·메뉴 팝업 권한 (이벤트·링크 열기)",
  "windows": [
    "overlay"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:event:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "slack://*"
        }
      ]
    }
  ]
}
