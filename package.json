{
  "name": "ddoktti-here",
  "private": true,
  "version": "0.1.23",
  "description": "똑띠왔어요 — Slack·캘린더와 함께하는 데스크톱 캐릭터 앱",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev:desktop": "pnpm --filter @ddoktti/desktop dev",
    "tauri": "pnpm --filter @ddoktti/desktop tauri",
    "icons": "node scripts/export-pet-svg.mjs && node scripts/export-native-icons.mjs",
    "svg": "node scripts/export-pet-svg.mjs"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
